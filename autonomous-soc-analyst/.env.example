# =============================================================================
# Autonomous SOC Analyst - configuration (copy to .env). All vars are prefixed SOC_.
# Start in mock mode; move to live only after `check`, sealing, and a dry run.
# =============================================================================

# ---- operating mode ----
SOC_MOCK_MODE=true            # true = simulated tenant, nothing real is touched
SOC_ARMED=false               # live mode: MUST be true for real actions; else everything is a dry run
SOC_DRY_RUN=false             # force dry run even if armed
SOC_SLA_SECONDS=28

# ---- API auth (required in live mode; admin key MUST differ) ----
SOC_API_KEY=
SOC_ADMIN_API_KEY=
# SOC_WEBHOOK_HMAC_SECRET=    # if set, SIEM webhooks may sign with X-Signature-256 instead of the API key
# SOC_PUBLIC_BASE_URL=https://soc-agent.internal   # for "Open report" links in notifications

# ---- Microsoft (Defender for Endpoint + Entra ID via Graph) ----
# App registration with the permissions listed in connectors/microsoft.py
SOC_TENANT_ID=
SOC_CLIENT_ID=
SOC_CLIENT_SECRET=
SOC_IDENTITY_PROVIDER=entra   # entra | ad | hybrid
SOC_ISOLATION_TYPE=Full       # Full | Selective

# ---- on-prem Active Directory (only if identity_provider is ad/hybrid) ----
# SOC_AD_SERVER=ldaps://dc01.contoso.com
# SOC_AD_BIND_USER=CN=svc-soc-agent,OU=Service,DC=contoso,DC=com
# SOC_AD_BIND_PASSWORD=
# SOC_AD_BASE_DN=DC=contoso,DC=com

# ---- firewall ----
SOC_FIREWALL_PROVIDER=none    # none | panos | fortigate | defender_indicator
SOC_BLOCK_DURATION_SECONDS=86400
# SOC_PANOS_HOST=fw01.contoso.com
# SOC_PANOS_API_KEY=
# SOC_FORTIGATE_HOST=fw01.contoso.com
# SOC_FORTIGATE_TOKEN=

# ---- threat intelligence (configure the feeds you have; more = better consensus) ----
# SOC_VIRUSTOTAL_API_KEY=
# SOC_ABUSECH_AUTH_KEY=       # MalwareBazaar + ThreatFox (abuse.ch)
# SOC_OTX_API_KEY=
# SOC_ABUSEIPDB_API_KEY=
# SOC_GREYNOISE_API_KEY=
# SOC_HYBRID_ANALYSIS_API_KEY=
# SOC_MISP_URL=https://misp.contoso.com
# SOC_MISP_API_KEY=

# ---- optional AI summary (writes report prose only; never makes decisions) ----
# SOC_ANTHROPIC_API_KEY=
# SOC_LLM_MODEL=claude-haiku-4-5-20251001

# ---- SOC notifications ----
# SOC_TEAMS_WEBHOOK_URL=
# SOC_SLACK_WEBHOOK_URL=
# SOC_PAGERDUTY_ROUTING_KEY=
# SOC_TICKET_WEBHOOK_URL=

# ---- SAFETY / admin out-of-band alerting (SEPARATE from SOC channels) ----
# SOC_ADMIN_WEBHOOK_URL=      # where the admin is paged on breakout/self-heal/kill events
SOC_ADMIN_WEBHOOK_FORMAT=teams   # teams | slack | json
# SOC_ADMIN_PAGERDUTY_ROUTING_KEY=
# SOC_KILL_SWITCH=false       # set true (env) to force a full stop regardless of the kill file
# SOC_EGRESS_EXTRA_HOSTS=     # comma-separated extra hosts the agent may call (e.g. an internal proxy)

# ---- Defender alert poller (alternative to webhooks) ----
SOC_ENABLE_POLLER=false
SOC_POLL_INTERVAL_SECONDS=30
